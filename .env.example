DEBUG=False
SECRET_KEY=<generate-a-strong-random-key>
ALLOWED_HOSTS=kharchayapi.14labs.co
POSTGRES_DB=kharchay_db
POSTGRES_USER=kharchay_user
POSTGRES_PASSWORD=<strong-db-password>
DATABASE_URL=postgres://kharchay_user:<strong-db-password>@db:5432/kharchay_db
REDIS_URL=redis://redis:6379/0
# Payment-proof images use Django FileSystemStorage; MEDIA_ROOT is bind-mounted
# to ./data on the host (see docker-compose.yml). Defaults to BASE_DIR/media.
MEDIA_ROOT=/app/media
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Kharchay <no-reply@kharchay.app>
